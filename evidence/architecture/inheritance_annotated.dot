// Annotated copy of ArchitectureDemo.sol.dot (Slither inheritance-graph printer output).
// Same nodes/edges; only colors and role labels added for the report.
digraph "" {
fontname="Times New Roman"; node [fontname="Times New Roman"]; edge [fontname="Times New Roman"];
labelloc="t"; label=<<B>ArchitectureDemo.sol – inheritance graph (đã đánh dấu vai trò)</B>>;

c25_AccessManaged[shape="box" style="filled,bold" fillcolor="#FDE9D9" color="#C0504D" penwidth=2 label=< <TABLE border="0"><TR><TD align="center"><FONT COLOR="#C0504D"><B>[QUYỀN – Access control]</B></FONT></TD></TR><TR><TD align="center"><B>AccessManaged</B></TD></TR><TR><TD align="left"><I>Modifiers:</I></TD></TR><TR><TD align="left">    onlyAdmin()</TD></TR><TR><TD align="left"><I>Public Variables:</I></TD></TR><TR><TD align="left">    admin</TD></TR></TABLE> >];

c56_BalanceLedger[shape="box" style="filled,bold" fillcolor="#E2EFDA" color="#548235" penwidth=2 label=< <TABLE border="0"><TR><TD align="center"><FONT COLOR="#548235"><B>[SỐ DƯ – Balance mapping]</B></FONT></TD></TR><TR><TD align="center"><B>BalanceLedger</B></TD></TR><TR><TD align="left"><I>Public Functions:</I></TD></TR><TR><TD align="left">    balanceOf(address)</TD></TR><TR><TD align="left"><I>Private Functions:</I></TD></TR><TR><TD align="left">    _credit(address,uint256)</TD></TR><TR><TD align="left"><I>Private Variables:</I></TD></TR><TR><TD align="left">    balances</TD></TR></TABLE> >];

c97_StudentAsset -> c25_AccessManaged [ label="1" ];
c97_StudentAsset -> c56_BalanceLedger [ label="2" ];
c97_StudentAsset[shape="box" style="filled,bold" fillcolor="#DDEBF7" color="#2F5597" penwidth=2 label=< <TABLE border="0"><TR><TD align="center"><FONT COLOR="#2F5597"><B>[ENTRYPOINT – gọi từ bên ngoài]</B></FONT></TD></TR><TR><TD align="center"><B>StudentAsset</B></TD></TR><TR><TD align="left"><I>Public Functions:</I></TD></TR><TR><TD align="left">    mint(address,uint256)</TD></TR></TABLE> >];
}
